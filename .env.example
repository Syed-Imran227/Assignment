# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
REASONING_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant

# Database Configuration (Default is local SQLite, or set to PostgreSQL)
# SQLite: sqlite+aiosqlite:///./rootline.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/rootline
DATABASE_URL=sqlite+aiosqlite:///./rootline.db

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
